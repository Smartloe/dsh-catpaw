{
  "name": "dsh-catpaw",
  "version": "1.1.0",
  "private": true,
  "description": "CatPaw (妙手) model bridge for DeepSeek Harness: registers the CatPaw agent's 12 models as a selectable LLM provider.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "bin/",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "login.mjs",
    "stream-text.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
